# Local development: copy this file to the repository root as .env. On each
# backend restart, root .env values override inherited terminal/session values.
# Deployments without a root .env continue to use their platform environment.

# --- Deployment / frontend origin ---
# Set FRONTEND_URL to the exact deployed frontend origin in production.
FRONTEND_URL=http://localhost:5173
# Comma-separated; defaults to FRONTEND_URL when omitted.
CORS_ORIGINS=http://localhost:5173

# --- Runtime limits ---
# 0 sends all history; invalid or negative values fall back to 10.
MAX_HISTORY_MESSAGES=10
AUDIO_MAX_AGE_SECONDS=3600

# --- LLM Providers (provide at least one) ---
# Option 1: OpenRouter API (recommended; supports multiple model families)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=google/gemini-2.0-flash-001

# Option 2: NVIDIA NIM API (Llama 3.3, DeepSeek R1, etc.)
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_MODEL=meta/llama-3.3-70b-instruct

# Option 3: Direct Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here


# --- TTS / voice synthesis providers ---
# Option 1: ElevenLabs (best control over voice identity and delivery)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=myFdf83MJZVXe8yKeA6H
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
ELEVENLABS_STABILITY=0.62
ELEVENLABS_SIMILARITY_BOOST=0.78
ELEVENLABS_STYLE=0.08
ELEVENLABS_USE_SPEAKER_BOOST=true
ELEVENLABS_SPEED=1.0

# Option 2: Custom / OpenAI-compatible TTS endpoint
# This provider is tried after ElevenLabs when TTS_API_KEY is valid.
# Leave TTS_BASE_URL blank to use the OpenAI SDK default endpoint.
TTS_API_KEY=your_tts_api_key_here
TTS_BASE_URL=https://api.openai.com/v1
TTS_MODEL=gpt-4o-mini-tts
TTS_VOICE=ash
TTS_SPEED=1.0
TTS_INSTRUCTIONS="Speak in a warm, calm, confident, slightly deep male voice with a clear neutral international English accent. Use a natural conversational cadence at a medium pace, with subtle sophistication and natural pauses. Sound professional and composed, never robotic, announcer-like, overly cheerful, or bass-heavy."

# Option 3: Free gTTS fallback (no key required)
