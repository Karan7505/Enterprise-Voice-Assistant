# ─── LLM Providers (Provide at least one) ──────────────────────────────────────
# Option 1: OpenRouter API (Recommended — supports Gemini 2.0, Llama 3.3, DeepSeek, GPT-4o)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=google/gemini-2.0-flash-001

# Option 2: Bytez.com API (Supports open source & commercial LLM/TTS models)
BYTEZ_API_KEY=your_bytez_api_key_here
BYTEZ_MODEL=openai/gpt-4o-mini

# Option 3: NVIDIA NIM API (Llama 3.3, DeepSeek R1, etc.)
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_MODEL=meta/llama-3.3-70b-instruct

# Option 4: Direct Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here


# ─── TTS / Voice Synthesis Providers ──────────────────────────────────────────
# Option 1: ElevenLabs API Key
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Option 2: Bytez.com Audio API Key (Same BYTEZ_API_KEY as above)

# Option 3: Custom / OpenAI Audio API Endpoint
TTS_API_KEY=your_tts_api_key_here
TTS_BASE_URL=https://api.openai.com/v1

# Option 4: Free gTTS Fallback (Zero cost, built-in — no keys required!)