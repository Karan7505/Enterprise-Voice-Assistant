# Production environment template for the Enterprise Voice Assistant.
# Copy to .env (or inject via your platform's secret store / orchestrator) and
# fill in real values. NEVER commit the real .env. Rotate any secret that has
# ever been committed, shared, or copied into an artifact.

# --- Deployment / frontend ---------------------------------------------------
# Public origin of the SPA. Drives CORS and same-site cookie behavior.
FRONTEND_URL=https://your-app.example.com
# Explicit origin allow-list. Do NOT use a wildcard when credentials are enabled.
CORS_ORIGINS=https://your-app.example.com

# --- LLM (set at least one provider) -----------------------------------------
OPENROUTER_API_KEY=
NVIDIA_API_KEY=
GEMINI_API_KEY=

# --- TTS (set at least one; gTTS free fallback is always available) ----------
ELEVENLABS_API_KEY=
TTS_API_KEY=
TTS_BASE_URL=
TTS_MODEL=
TTS_VOICE=

# --- CRM / outbound connectors (leave blank to keep a connector OFF) ---------
CRM_PROVIDER=directory
CRM_CONTACTS=
WA_TOKEN=
WA_PHONE_NUMBER_ID=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USERNAME=
EMAIL_PASSWORD=

# --- Security: authentication -----------------------------------------------
# Enterprise deployments should provision accounts out-of-band, not open signup.
ALLOW_REGISTRATION=false
# Absolute session lifetime (minutes).
TOKEN_TTL_MINUTES=720
# Session cookie: same origin / single-domain reverse proxy -> "lax".
# A cross-site API host needs "none" and MUST be served over HTTPS.
COOKIE_SECURE=true
COOKIE_SAMESITE=lax
COOKIE_PATH=/

# --- Security: rate limits (requests per window; 0 disables) -----------------
RATE_LIMIT_LOGIN=5
RATE_LIMIT_REGISTER=5
RATE_LIMIT_CHAT=12
RATE_LIMIT_WINDOW_SECONDS=60

# --- Security: outbound business actions (fail closed) -----------------------
# Disabled unless explicitly enabled AND the acting user is allowlisted.
BUSINESS_ACTIONS_ENABLED=false
BUSINESS_ACTION_ALLOWED_USERS=
BUSINESS_ACTION_MAX_PER_HOUR=20
BUSINESS_ACTION_REQUIRE_CONFIRMATION=true
BUSINESS_ACTION_CONFIRM_TTL_SECONDS=300

# --- Storage (pin to absolute paths outside any web-accessible tree) ---------
DATABASE_PATH=/srv/data/assistant.db
AUDIO_DIR=/srv/data/audio

# --- App ---------------------------------------------------------------------
MAX_HISTORY_MESSAGES=10
MAX_MESSAGE_LENGTH=4000
AUDIO_MAX_AGE_SECONDS=3600
