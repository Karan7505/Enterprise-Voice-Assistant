# Production environment reference — Enterprise Voice Assistant
#
# HOW THIS IS USED IN THE ECS DEPLOYMENT:
#   The real values are NOT read from a file. The ECS task definition
#   (infra/ecs.tf) injects the "SECRET" items below at container start from
#   the AWS Secrets Manager secret <project>/<environment>/app, and the
#   "TASK DEF ENV" items as plain task environment. This file documents the
#   complete surface and is also usable to build a local production-clone.
#
#   NEVER put real credentials in this file or commit a filled-in copy.
#   .env* (except *.example) is gitignored.
#
# Legend:
#   [secret]    = injected from Secrets Manager at runtime (never in code/image)
#   [task env]  = set in the task definition by Terraform (non-secret)
#   [optional]  = has a safe default; only set to override

# ============================= Identity / auth =============================
# Token lifetime in minutes (12 h). [optional]
TOKEN_TTL_MINUTES=720
# Cookie attributes. COOKIE_SECURE must be true in production (HTTPS only). [optional]
COOKIE_NAME=jarvis_token
COOKIE_SECURE=true
COOKIE_SAMESITE=lax
COOKIE_PATH=/
# Public registration. Set false once your users are onboarded. [optional]
ALLOW_REGISTRATION=true

# ============================ Rate limiting ================================
# Per-window limits (window = RATE_LIMIT_WINDOW_SECONDS). Shared across all
# instances via Redis. [optional]
RATE_LIMIT_LOGIN=5
RATE_LIMIT_REGISTER=5
RATE_LIMIT_CHAT=12
RATE_LIMIT_WINDOW_SECONDS=60

# ============================ Core services ===============================
# [secret] postgresql://evoa:<random>@<rds-endpoint>/assistant   (TF-generated)
DATABASE_URL=postgresql://evoa:CHANGE_ME@db.example.region.rds.amazonaws.com:5432/assistant
# Connection pool (20/20 keeps a pre-warmed set; see app/core/database.py). [optional]
PG_POOL_MIN=20
PG_POOL_MAX=20
# [secret] rediss://:<auth-token>@<elasticache-endpoint>:6379/0  (TF-generated)
REDIS_URL=rediss://CHANGE_ME@redis.example.region.cache.amazonaws.com:6379/0
# Context cache TTL in seconds (rebuildable from the DB). [optional]
CONTEXT_CACHE_TTL_SECONDS=86400

# ============================== S3 audio ==================================
# Real AWS S3: leave the endpoint EMPTY and the keys EMPTY — the app uses
# the boto3 default chain (the ECS task role). [secret, empty by design]
S3_ENDPOINT_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=
# Bucket + region set by Terraform. [task env]
S3_BUCKET=evoa-production-assistant-audio
S3_REGION=ap-south-1
# Keyless local-dev/CI only — never in production. [optional]
# S3_LOCAL_FS=1

# ====================== LLM providers (any 1+) ============================
# At least one LLM key is required or /chat returns 503 by design.
# [secret] — fill whichever provider(s) you use; empty ones are skipped.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.0-flash-001
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.3-70b-instruct
GEMINI_API_KEY=
# Endpoint overrides exist for load testing/stubs; keep defaults in production. [optional]
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# ============================== TTS ========================================
# [secret]
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_turbo_v2
ELEVENLABS_STABILITY=0.5
ELEVENLABS_SIMILARITY_BOOST=0.75
ELEVENLABS_STYLE=0
ELEVENLABS_USE_SPEAKER_BOOST=true
ELEVENLABS_SPEED=1.0
# OpenAI-compatible TTS (optional second provider). [secret]
TTS_API_KEY=
# TTS_BASE_URL=
TTS_MODEL=gpt-4o-mini-tts
TTS_VOICE=ash
TTS_SPEED=1.0
# TTS_INSTRUCTIONS=

# ===================== Business actions (CRM / WA / Email) =================
# Off by default. Enable only after configuring the allowlist + recipients.
BUSINESS_ACTIONS_ENABLED=false
# Comma-separated usernames allowed to trigger sends. [optional]
# BUSINESS_ACTION_ALLOWED_USERS=
BUSINESS_ACTION_MAX_PER_HOUR=20
# Require an explicit "yes" before each send. Keep true. [optional]
BUSINESS_ACTION_REQUIRE_CONFIRMATION=true
BUSINESS_ACTION_CONFIRM_TTL_SECONDS=300

# CRM: "directory" (embedded CRM_CONTACTS JSON) or "rest". [optional]
CRM_PROVIDER=directory
# CRM_CONTACTS=
# [secret] REST mode only:
CRM_REST_BASE_URL=https://crm.example.com
CRM_REST_API_KEY=
CRM_REST_AUTH_HEADER=Authorization
CRM_REST_AUTH_SCHEME=Bearer
CRM_REST_SEARCH_PATH=/contacts/search
CRM_REST_QUERY_PARAM=q
CRM_REST_RESULTS_KEY=results
CRM_REST_TIMEOUT=10
CRM_REST_NAME_FIELD=name
CRM_REST_PHONE_FIELD=phone
CRM_REST_EMAIL_FIELD=email

# WhatsApp Cloud API. [secret]
WA_TOKEN=
WA_PHONE_NUMBER_ID=
WA_GRAPH_VERSION=v19.0

# SMTP (any provider; Gmail/Outlook/app-password). [secret]
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_USE_TLS=true

# ========================= Resilience (blueprint) =========================
# Timeouts (s): LLM 10 / TTS 15 / CRM 5 / WhatsApp 10 / SMTP 10. [optional]
LLM_TIMEOUT_SECONDS=10
TTS_TIMEOUT_SECONDS=15
CRM_TIMEOUT_SECONDS=5
WHATSAPP_TIMEOUT_SECONDS=10
SMTP_TIMEOUT_SECONDS=10
# Retry attempts: LLM 3 / TTS 2. [optional]
LLM_MAX_RETRIES=3
TTS_MAX_RETRIES=2
# Circuit breaker: open after N consecutive failures, reset after M seconds. [optional]
CIRCUIT_FAIL_MAX=5
CIRCUIT_RESET_SECONDS=60

# ============================== Frontend ===================================
# The public origin of the SPA. CORS_ORIGINS is a comma-separated list. [task env]
FRONTEND_URL=https://assistant.example.com
CORS_ORIGINS=https://assistant.example.com
# Maximum user message length. [optional]
MAX_MESSAGE_LENGTH=4000

# ============================ Local only (not ECS) =========================
# These default to local dev values and must NOT be set in production:
#   AUDIO_DIR, DATABASE_PATH (legacy), LOG_FORMAT (ECS sets json),
#   LOG_DB_TIMINGS (1 = per-query timing in logs; load testing only)
