# --- Python ---
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg-info/
dist/
build/
*.egg
.eggs/

# --- Virtual environment ---
venv/
.venv/
env/

# --- Environment variables (never commit real keys) ---
# Ignore every .env file EXCEPT the committed examples.
.env
.env.*
!.env.example
!.env.production.example

# --- SQLite database (auto-created at runtime) ---
assistant.db

# --- Generated audio files ---
audio/
*.mp3
*.wav

# --- Frontend: Node and build output ---
frontend/node_modules/
frontend/dist/
frontend/.vite/
.vite/
frontend/.env
frontend/.env.local
frontend/.env.development

# --- Editor / IDE ---
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# --- OS ---
.DS_Store
Thumbs.db

# --- Miscellaneous ---
*.log
*.bak
.uv-cache/

# --- Terraform (state must never be committed) ---
infra/.terraform/
infra/*.tfstate
infra/*.tfstate.*
infra/*.tfvars
infra/terraform.tfvars.json
!infra/terraform.tfvars.example
