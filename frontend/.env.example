# Development already uses http://localhost:8000 via .env.development.
# For separate deployments, set the public backend URL before running the build.
# Leave this empty only when the frontend and API share an origin.
VITE_API_BASE_URL=http://localhost:8000

# Delay before the initial/fresh Jarvis state begins its space ambience.
VITE_JARVIS_INITIAL_IDLE_DELAY_MS=500

# Inactivity required before ambience returns during an existing conversation.
VITE_JARVIS_IDLE_DELAY_MS=15000
